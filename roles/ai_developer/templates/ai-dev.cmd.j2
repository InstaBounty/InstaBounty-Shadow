@echo off
setlocal EnableExtensions EnableDelayedExpansion
set "AIDER_EDIT_FORMAT=whole"
set "AIDER_FANCY_INPUT=false"
echo AI developer runner version: {{ ai_developer_runner_version }}

set "EXPECTED_BRANCH="
if /I "%~3"=="--branch" set "EXPECTED_BRANCH=%~4"

if defined EXPECTED_BRANCH (
    set "CURRENT_BRANCH="
    for /f "delims=" %%B in ('git -C "%~2" branch --show-current 2^>nul') do set "CURRENT_BRANCH=%%B"
    if /I not "!CURRENT_BRANCH!"=="!EXPECTED_BRANCH!" (
        echo ERROR: Expected existing pull request branch '!EXPECTED_BRANCH!' before AI developer start, but Git is on '!CURRENT_BRANCH!'. 1>&2
        exit /b 1
    )
    echo AI developer branch invariant: !EXPECTED_BRANCH!
)

py -3 -c "import base64,runpy,sys; p=r'{{ ai_developer_install_dir }}\ai_developer.py'; i=next((n for n,v in enumerate(sys.argv) if v=='--task-base64'),None); i is None or sys.argv.__setitem__(slice(i,i+2),['--task',base64.b64decode(sys.argv[i+1],validate=True).decode('utf-8')]); sys.argv[0]=p; ns=runpy.run_path(p,run_name='ai_developer_bridge'); task=sys.argv[sys.argv.index('--task')+1] if '--task' in sys.argv else ''; task and print('Review contract detected: R={}, F={}'.format(len(ns['canonical_requirements'](task)),len(ns['github_review_requirements'](task)))); raise SystemExit(ns['main']())" develop --model "{{ ai_developer_model }}" --reviewer-model "{{ ai_reviewer_model }}" --ollama-url "{{ ai_developer_ollama_url }}" --aider-command "{{ ai_developer_aider_command }}" --review-passes {{ ai_developer_review_passes }} %*
set "AI_DEV_EXIT=!ERRORLEVEL!"

if defined EXPECTED_BRANCH (
    set "CURRENT_BRANCH_AFTER="
    for /f "delims=" %%B in ('git -C "%~2" branch --show-current 2^>nul') do set "CURRENT_BRANCH_AFTER=%%B"
    if /I not "!CURRENT_BRANCH_AFTER!"=="!EXPECTED_BRANCH!" (
        echo ERROR: AI developer changed branch from '!EXPECTED_BRANCH!' to '!CURRENT_BRANCH_AFTER!'; refusing successful completion. 1>&2
        exit /b 1
    )
)

exit /b !AI_DEV_EXIT!
